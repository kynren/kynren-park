{
  "expo": {
    "name": "Kynren",
    "slug": "kynren-storied-lands",
    "scheme": "kynren",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#8f1d21",
    "description": "Your offline-first companion for Kynren – The Storied Lands: live show times, a smart itinerary planner, an offline park map, digital tickets and Click & Collect.",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kynren.storiedlands",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Kynren uses your location to show where you are on the park map and time your show reminders.",
        "NSCameraUsageDescription": "Kynren uses the camera to scan spot QR codes so it can show them on the map."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.kynren.storiedlands",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8f1d21"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kynren uses the camera to scan spot QR codes so it can show them on the map."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://app-park.kynren.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1b178732-f66c-47e9-a8e0-02dd45a080db"
      }
    },
    "owner": "kynrenadmins-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1b178732-f66c-47e9-a8e0-02dd45a080db"
    }
  }
}
