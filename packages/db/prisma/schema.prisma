// Kynren – The Storied Lands data model.
// Provider: PostgreSQL. Generate the client with `npm run db:generate`.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the debian/musl targets are for the Linux runtime
  // on Prisma Compute (the custom build runs locally and ships the artifact).
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AttractionCategory {
  BIRDS // The Lost Feather
  HORSE // medieval horsemanship tale
  LAKE // Legend of the Wear (Lambton Worm)
  VIKINGS // Land of the Vikings
  MAZE // Victorian Imaginariums
  EVENING_SHOW // Kynren – An Epic Tale of England
  OTHER
}

enum SessionStatus {
  SCHEDULED
  DELAYED
  CANCELLED
  FULL
  FINISHED
}

enum PoiType {
  ATTRACTION
  RESTAURANT
  RESTROOM
  SHOP
  FIRST_AID
  ENTRANCE
  PARKING
  ACCESSIBILITY
  BABY_CHANGING
  PICNIC
  INFO
}

enum StaffRole {
  ADMIN
  OPS
  FNB
  CONTENT
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

enum TicketCategory {
  ADULT
  CHILD
  CONCESSION
  FAMILY
  INFANT
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum PriceRange {
  BUDGET
  MODERATE
  PREMIUM
}

enum AnnouncementAudience {
  ALL
  DATE // everyone visiting a given date
  TICKET_HOLDERS
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(cuid())
  email              String?  @unique
  name               String?
  passwordHash       String?
  locale             String   @default("en-GB")
  // Accessibility preferences kept as a flexible JSON blob.
  accessibilityPrefs Json?
  // Last known location, used to show who is in the park right now.
  lastLat            Float?
  lastLng            Float?
  lastSeenAt         DateTime?
  pushTokens         PushToken[]
  refreshTokens      RefreshToken[]
  bookings           Booking[]
  itineraries        Itinerary[]
  favorites          Favorite[]
  seen               AttractionSeen[]
  orders             Order[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String // ios | android
  // Optional: device tokens register on launch (guests included); linked to a
  // user once they sign in, so we can target either everyone or specific users.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model StaffUser {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            StaffRole @default(OPS)
  active          Boolean   @default(true)
  // Email-invite flow: a pending invite is inactive until the person accepts
  // (opens the tokened link, sets their name + password).
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Editable role→permission matrix that drives both the admin UI and the API
// PermissionsGuard. One row per (role, permission); ADMIN is always allowed.
model RolePermission {
  id         String    @id @default(cuid())
  role       StaffRole
  permission String
  allowed    Boolean   @default(false)
  updatedAt  DateTime  @updatedAt

  @@unique([role, permission])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Attractions, sessions & map
// ---------------------------------------------------------------------------

model Attraction {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  category       AttractionCategory
  tagline        String?
  synopsis       String
  durationMins   Int
  capacity       Int?
  heroImage      String?
  media          String[] // additional image / video URLs
  // Accessibility flags surfaced in the app.
  wheelchairAccessible Boolean @default(true)
  hasAudioDescription  Boolean @default(false)
  hasCaptioning        Boolean @default(false)
  hasBSL               Boolean @default(false)
  sensoryNotes         String?
  minAge               Int?
  // Location on the park map.
  poi            PointOfInterest?   @relation(fields: [poiId], references: [id])
  poiId          String?            @unique
  sessions       ShowSession[]
  weeklySessions WeeklySession[]
  favorites      Favorite[]
  seen           AttractionSeen[]
  sortOrder      Int                @default(0)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model ShowSession {
  id           String        @id @default(cuid())
  attraction   Attraction    @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  attractionId String
  date         DateTime      @db.Date
  startTime    DateTime
  endTime      DateTime
  status       SessionStatus @default(SCHEDULED)
  // When DELAYED, the revised start; when CANCELLED, an optional reason.
  revisedStart DateTime?
  note         String?
  capacity     Int?
  itineraryItems ItineraryItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([date])
  @@index([attractionId, date])
}

// The weekly programme: a show runs on a given weekday at a given time. This is
// the source of truth for scheduling (the park repeats a weekly pattern across
// the season), so admins pick days of the week — not calendar dates.
model WeeklySession {
  id           String        @id @default(cuid())
  attraction   Attraction    @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  attractionId String
  dayOfWeek    Int           // 0 = Sunday … 6 = Saturday
  start        String        // "HH:MM" park time
  end          String        // "HH:MM" park time
  status       SessionStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([dayOfWeek])
  @@index([attractionId])
}

model PointOfInterest {
  id         String      @id @default(cuid())
  type       PoiType
  name       String
  description String?
  lat        Float
  lng        Float
  mapZone    String?
  icon       String?
  color      String? // hotspot marker colour (admin-editable)
  image      String? // optional image shown inside the marker
  heroImage    String? @db.Text // large image for the facility detail page
  openingHours String? // e.g. "10:00–18:00", shown on the detail page
  attraction Attraction?
  restaurant Restaurant?
  shop       Shop?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([type])
}

// Park base maps. Admin can add several; exactly one is the default that the
// mobile app displays. Image can be changed or removed (illustrated fallback).
model ParkMap {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  bgColor   String? // average colour of the image; fills the map screen edges
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

// Singleton map configuration edited from the admin map editor.
// Workspace branding (logo + icon + colours), shown across the admin and the
// mobile app. Singleton row.
model Branding {
  id        String   @id @default(cuid())
  singleton Boolean  @default(true) @unique
  appName   String   @default("Kynren")
  tagline   String   @default("The Storied Lands")
  primary   String   @default("#8f1d21")
  accent    String   @default("#22b365")
  font      String   @default("system") // system | serif | rounded | mono
  logoUrl    String?  @db.Text
  iconUrl    String?  @db.Text
  faviconUrl String?  @db.Text
  // In-app loading screen: type = none | photo | gif | video, media = data URL
  // (photo/gif) or a hosted URL (recommended for video).
  splashType     String  @default("none")
  splashMediaUrl String? @db.Text
  // Season opening date (YYYY-MM-DD) shown in the app's "programme available
  // from" message.
  seasonOpens    String?
  updatedAt  DateTime @updatedAt
}

model MapConfig {
  id          String   @id @default(cuid())
  singleton   Boolean  @default(true) @unique
  markerColor String   @default("#1a73e8")
  markerStyle String   @default("pulse") // pulse | pin | dot
  mapImageUrl String?
  minLat      Float?
  maxLat      Float?
  minLng      Float?
  maxLng      Float?
  // Initial mobile map view (admin-tunable): opening zoom, max zoom, and the
  // lat/lng to centre on. Null centre → the middle of the map.
  initialZoom Float    @default(2)
  maxZoom     Float    @default(8)
  centerLat   Float?
  centerLng   Float?
  // Entrance animation for the mobile marker popup: none | fade | scale | slide | bounce
  popupAnimation String @default("scale")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pre-computed walking times (seconds) between POIs, used by the planner.
model WalkEdge {
  id         String          @id @default(cuid())
  fromPoiId  String
  toPoiId    String
  seconds    Int

  @@unique([fromPoiId, toPoiId])
}

// ---------------------------------------------------------------------------
// Food & beverage / Click & Collect
// ---------------------------------------------------------------------------

model Restaurant {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  cuisine      String?
  description  String?
  priceRange   PriceRange @default(MODERATE)
  openingHours String?
  heroImage    String?
  clickCollect Boolean    @default(true)
  poi          PointOfInterest? @relation(fields: [poiId], references: [id])
  poiId        String?    @unique
  menuItems    MenuItem[]
  orders       Order[]
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  description  String?
  priceCents   Int
  dietaryTags  String[] // e.g. ["vegan","gf"]
  image        String?
  available    Boolean  @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
}

// A retail shop in the park. Mirrors Restaurant: it has a featured image,
// an optional map location, and a list of products (ShopItem) shown in the app.
model Shop {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  category     String? // e.g. "Gifts", "Sweets", "Clothing"
  description  String?
  heroImage    String? // featured image, populated throughout the app
  openingHours String?
  poi          PointOfInterest? @relation(fields: [poiId], references: [id])
  poiId        String?    @unique
  items        ShopItem[]
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// A product sold at a shop. `variants` holds optional varieties of the product
// as a JSON array of { name, priceCents? } (e.g. sizes, colours, flavours).
model ShopItem {
  id          String   @id @default(cuid())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      String
  name        String
  description String?
  image       String?
  priceCents  Int      @default(0)
  variants    Json? // [{ name: string, priceCents?: number }]
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
}

model Order {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  restaurantId String
  status       OrderStatus @default(PENDING)
  pickupSlot   DateTime
  totalCents   Int
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([restaurantId, status])
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  quantity   Int
  priceCents Int // snapshot at order time
}

// ---------------------------------------------------------------------------
// Tickets & bookings
// ---------------------------------------------------------------------------

model TicketType {
  id          String         @id @default(cuid())
  name        String
  category    TicketCategory
  priceCents  Int
  description String?
  onSale      Boolean        @default(true)
  tickets     Ticket[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Booking {
  id         String   @id @default(cuid())
  reference  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  visitDate  DateTime @db.Date
  totalCents Int
  tickets    Ticket[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Ticket {
  id           String       @id @default(cuid())
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId    String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  holderName   String?
  // Signed token encoded into the offline QR code.
  qrToken      String       @unique
  status       TicketStatus @default(VALID)
  usedAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Itinerary planner
// ---------------------------------------------------------------------------

model Itinerary {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime        @db.Date
  items     ItineraryItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, date])
}

model ItineraryItem {
  id            String      @id @default(cuid())
  itinerary     Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  itineraryId   String
  showSession   ShowSession @relation(fields: [showSessionId], references: [id], onDelete: Cascade)
  showSessionId String
  order         Int
  reminderMins  Int         @default(20)

  @@unique([itineraryId, showSessionId])
  @@index([itineraryId])
}

model Favorite {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  attractionId String
  createdAt    DateTime   @default(now())

  @@unique([userId, attractionId])
}

model AttractionSeen {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  attractionId String
  seenAt       DateTime   @default(now())

  @@unique([userId, attractionId])
}

// ---------------------------------------------------------------------------
// Announcements / notifications & CMS content
// ---------------------------------------------------------------------------

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  targetDate  DateTime?            @db.Date
  deepLink    String?
  scheduledAt DateTime?
  sentAt      DateTime?
  startAt     DateTime? // active-from (when it becomes "due" in the app)
  endAt       DateTime? // active-to (expires)
  recurrence  String    @default("none") // none | daily | weekly
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([targetDate])
}

// Reusable push-notification templates, assignable to app actions.
model NotificationTemplate {
  id        String   @id @default(cuid())
  name      String
  action    String   @default("CUSTOM") // SHOW_REMINDER | ORDER_READY | DELAY_ALERT | ANNOUNCEMENT | WELCOME | CUSTOM
  title     String
  body      String
  deepLink  String?
  sound     Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String // markdown
  category  String? // faq | info | safety | accessibility
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// One recorded result of a system health probe (API, DB, SMTP, push, realtime),
// kept ~90 days to draw the status-page uptime history.
model HealthCheck {
  id        String   @id @default(cuid())
  component String // api | database | email | push | realtime
  status    String // up | down | degraded
  latencyMs Int?
  detail    String?
  checkedAt DateTime @default(now())

  @@index([component, checkedAt])
  @@index([checkedAt])
}

// Generic key/value store for small operational settings (e.g. the status-page
// check interval). Not for secrets.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Admin-managed decorative image for a named mobile "slot". Lets the super-admin
// swap any hardcoded image, per theme, and control how it's fitted and animated.
model ManagedImage {
  key          String   @id // slot key, e.g. "profile.header"
  imageUrl     String?  @db.Text // light-theme image (data URL or hosted)
  imageUrlDark String?  @db.Text // dark-theme variant (optional)
  fit          String   @default("cover") // cover | contain
  position     String   @default("center") // top | center | bottom
  fade         String   @default("none") // none | up | down (edge fade into the screen)
  animation    String   @default("fade") // none | fade | slide-up | slide-down | zoom
  updatedAt    DateTime @updatedAt
}

// A designed mobile home screen. Admins can keep several layouts but exactly one
// is the live default. Publishing applies it now; scheduling makes it the
// default at publishAt. The mobile app renders the live default from the bundle.
model HomeScreen {
  id           String    @id @default(cuid())
  name         String
  isDefault    Boolean   @default(false)
  status       String    @default("draft") // draft | scheduled | published
  heroType     String    @default("none") // none | image | gif | video
  heroMediaUrl String?   @db.Text
  tagline      String? // large hero text
  greeting     String? // welcome heading
  greetingSub  String? // welcome subtitle
  primaryColor String?
  accentColor  String?
  sections     Json? // ordered [{ key, visible }]
  publishAt    DateTime?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
