{
  "name": "kynren-park",
  "version": "0.1.0",
  "private": true,
  "description": "Kynren – The Storied Lands: offline-first visitor app, backend API, and staff dashboard.",
  "//workspaces": "apps/mobile is intentionally excluded: as an Expo/React Native app it needs a standalone (non-hoisted) node_modules so Metro and EAS Gradle resolve react-native and its native modules consistently. Install it with `cd apps/mobile && npm install`.",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/admin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm run build:packages && npm run db:generate",
    "build:packages": "npm run build --workspace @kynren/shared && npm run build --workspace @kynren/db",
    "db:generate": "npm run generate --workspace @kynren/db",
    "db:migrate": "npm run migrate --workspace @kynren/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace @kynren/db",
    "db:seed": "npm run seed --workspace @kynren/db",
    "db:studio": "npm run studio --workspace @kynren/db",
    "dev:api": "npm run dev --workspace @kynren/api",
    "dev:admin": "npm run dev --workspace @kynren/admin",
    "dev:mobile": "npm run start --prefix apps/mobile",
    "install:mobile": "npm install --prefix apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.42",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "react-native": "0.74.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "~18.2.79",
    "multer": "^2.2.0",
    "lodash": "^4.18.1",
    "qs": "^6.15.3",
    "js-yaml": "^4.3.1",
    "body-parser": "^1.20.6",
    "express": "^4.22.2",
    "file-type": "^22.0.1"
  }
}
