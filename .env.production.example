# ─────────────────────────────────────────────────────────────────────────────
# Production env for the self-hosted stack (docker-compose.yml).
# Copy to `.env` on the VPS and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL the BROWSER uses to reach the API. This is inlined into the admin
# at BUILD time (NEXT_PUBLIC_*), so if you change it you must rebuild the admin.
NEXT_PUBLIC_API_URL=https://api.kynren.com

# Comma-separated list of origins allowed to call the API (the admin domain).
# Do NOT use "*" in production — name the exact admin origin.
CORS_ORIGINS=https://app-park.kynren.com

# Database.
#  • Leave this commented to use the built-in `postgres` container (empty DB —
#    you must push the schema + seed once, see DEPLOY-VPS.md).
#  • Or set it to your managed Prisma Postgres / Neon URL (already seeded).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# Secrets — generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
TICKET_QR_SECRET=replace-with-openssl-rand-hex-32
