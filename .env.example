# ---------------------------------------------------------------------------
# Kynren Park — environment template. Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) --------------------------------------------------
# Local Postgres:   postgresql://postgres:postgres@localhost:5432/kynren?schema=public
# Prisma Postgres / managed: paste the provider's connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kynren?schema=public"

# --- Redis (cache, pub/sub, job queue) --------------------------------------
REDIS_URL="redis://localhost:6379"

# --- API --------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# --- Auth (JWT) -------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Secret used to sign offline ticket QR tokens
TICKET_QR_SECRET="change-me-ticket-secret"

# --- Admin dashboard (Next.js) ----------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXTAUTH_SECRET="change-me-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Mobile app (Expo) ------------------------------------------------------
# Use your machine LAN IP for a physical device, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL="http://localhost:4000"

# --- Push notifications (Expo Push) -----------------------------------------
# Optional access token for higher rate limits; leave blank in dev.
EXPO_ACCESS_TOKEN=""
